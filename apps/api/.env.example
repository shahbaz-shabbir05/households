# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://hms:hms@localhost:5432/hms_dev
DATABASE_POOL_MAX=10

# --- Sessions & cookies -----------------------------------------------------
# Generate with: openssl rand -base64 48
# The app refuses to start in production while this is the development default.
SESSION_SECRET=dev-only-insecure-secret-change-me
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com

# --- Web client -------------------------------------------------------------
# Comma-separated exact origins. Never "*" — credentials are sent with requests.
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# --- Storage ----------------------------------------------------------------
# Files live outside the database and are never served from a public path.
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=10485760

# --- Email ------------------------------------------------------------------
EMAIL_DRIVER=console
EMAIL_FROM="Home Management System <no-reply@localhost>"

# --- Background jobs --------------------------------------------------------
# Set false on extra web instances if you ever run a dedicated job instance.
JOBS_ENABLED=true

# --- Observability ----------------------------------------------------------
LOG_LEVEL=info
TRUST_PROXY=false
